# ==========================================
# EDUKOM LEARNING PLATFORM ENVIRONMENT CONFIG
# ==========================================

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-key-here-min-50-characters
ALLOWED_HOSTS=learning.edukom.ng,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://learning.edukom.ng,http://127.0.0.1:8000

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///db.sqlite3

# Email Credentials
EMAIL_HOST=mail.edukom.ng
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=support@edukom.ng
EMAIL_HOST_PASSWORD=your_email_password_here

# Payment Gateway Configuration - Paystack
# Get keys from Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_webhook_signature_secret_here

# Payment Gateway Configuration - Flutterwave (Optional / Multi-currency)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_public_key_here
FLUTTERWAVE_SECRET_HASH=your_webhook_verif_hash_here

# Security Headers & Cookie Configurations
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
